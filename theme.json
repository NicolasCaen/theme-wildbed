{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "templateParts": [
        {
            "area": "header",
            "name": "header",
            "title": "Haut de page"
        },
        {
            "area": "footer",
            "name": "footer",
            "title": "Footer"
        },
        {
            "area": "uncategorized",
            "name": "query-loop",
            "title": "Boucle d'articles"
        }
    ],
    "customTemplates": [
        {
            "name": "index-small",
            "title": "Index Small"
        },
        {
            "name": "index-wide",
            "title": "Index Wide"
        },
        {
            "name": "search",
            "title": "Recherche"
        }
    ],
    "settings": {
        "custom": {
            "navigation": {
                "footer": "Footer Menu"
            }
        },
        "appearanceTools": true,
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Crisp",
                    "slug": "crisp",
                    "shadow": "6px 6px 0px 0px var(--wp--preset--color--accent)"
                },
                {
                    "name": "Outlined",
                    "slug": "outlined",
                    "shadow": "0px 4px 40px 0px rgba(0, 0, 0, 0.20)"
                },
                {
                    "name": "Outlined 2",
                    "slug": "outlined 2",
                    "shadow": "0px 2px 10px 0px rgba(31, 69, 96, 0.25)"
                }
            ]
        },
        "layout": {
            "contentSize": "960px",
            "wideSize": "clamp(1200px, calc(1200px + (1680 - 1200) * ((100vw - 1440px) / (1920 - 1440))), 1680px)"
        },
        "border": {
            "radiusSizes": [
                {
                    "name": "S |\u00a0.5rem",
