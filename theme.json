{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Haut de page"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
        {
			"area": "uncategorized",
			"name": "query-loop",
			"title": "Boucle d'articles"
		}
	],
	"customTemplates": [
        {
            "name": "index-small",
            "title": "Index Small"
        },
        {
            "name": "index-wide",
            "title": "Index Wide"
        },
		{
			"name": "search",
			"title": "Recherche"
		}
	],
    "settings": {
        "custom": {
            "navigation": {
              "footer": "Footer Menu"
            }
        },
        "appearanceTools": true,
        "shadow": {
            "defaultPresets": false,
            "presets": [
              {
                "name": "Crisp",
                "slug": "crisp",
                "shadow": "6px 6px 0px 0px var(--wp--preset--color--accent)"
              },
              {
                "name": "Outlined",
                "slug": "outlined",
                "shadow": "0px 4px 40px 0px rgba(0, 0, 0, 0.20)"
              },
              {
                "name": "Outlined 2",
                "slug": "outlined 2",
                "shadow": "0px 2px 10px 0px rgba(31, 69, 96, 0.25)"
              }
            ]
          },
        "layout": {
            "contentSize": "960px",
            "wideSize": "clamp(1200px, calc(1200px + (1680 - 1200) * ((100vw - 1440px) / (1920 - 1440))), 1680px)"
        },
        "border": {
			"radiusSizes": [
				{
					"name": "S | .5rem",
					"slug": "s",
					"size": "0.5rem"
				},
                {
                    "name": "M | .1rem",
                    "slug": "m",
                    "size": "1rem"
                },
                {
                    "name": "L",
                    "slug": "l",
                    "size": "1.5rem"
                },
                {
                    "name": "XL",
                    "slug": "xl",
                    "size": "2rem"
                },
                {
                    "name": "2XL",
                    "slug": "2xl",
                    "size": "4rem"
                },
                {
                    "name": "full",
                    "slug": "full",
                    "size": "100%"
                },
                {
                    "name": "rounded",
                    "slug": "rounded",
                    "size": "10rem"
                }
			]
		},
        "color": {
               "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "palette": [
                {
                    "slug": "base",
                    "name": "Background (Base)",
                    "color": "#E8F2EF"
                },
                {
                    "slug": "base-2",
                    "name": "Primary (Base-2)",
                    "color": "#2E5448"
                },
                {
                    "slug": "base-3",
                    "name": "Primary Dark (Base-3)",
                    "color": "#12211C"
                },
                {
                    "slug": "base-4",
                    "name": "Primary Light (Base-4)",
                    "color": "#CEE4DD"
                },
                {
                    "slug": "contrast",
                    "name": "Secondary (Contrast)",
                    "color": "#F9A01E"
                },
                {
                    "slug": "contrast-2",
                    "name": "Secondary Dark (Contrast-2)",
                    "color": "#623C06"
                },
                {
                    "slug": "contrast-3",
                    "name": "Secondary Light (Contrast-3)",
                    "color": "#FFEEE3"
                },
                {
                    "slug": "accent",
                    "name": "Contrast black (accent)",
                    "color": "#070707"
                },
                {
                    "slug": "accent-2",
                    "name": "Contrast white (accent-2)",
                    "color": "#ffffff"
                },
                {
                    "slug": "transparent",
                    "name": "Transparent",
                    "color": "transparent"
                },
                {
                    "slug": "inherit",
                    "name": "Inherit",
                    "color": "inherit"
                }
            ],
    "gradients": [
                {
                    "slug": "black-to-transparent",
                    "name": "Noir → Transparent",
                    "gradient": "linear-gradient(0deg, rgba(0, 0, 0, 0.60) 25%, rgba(0, 0, 0, 0.00) 53.85%)"
                }
            ],
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false
        },
        "typography": {
            "writingMode": true,
            "defaultFontSizes": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "\"Titan One\", system-ui",
                    "name": "Titan One",
                    "slug": "second",
                    "fontFace": [
                        {
                            "src": [
                                "file:./assets/fonts/titan-one/titan-one-400-normal.woff2"
                            ],
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontFamily": "\"Titan One\""
                        }
                    ]
                },
                {
                    "fontFamily": "\"Open Sans\", sans-serif",
                    "name": "Open Sans",
                    "slug": "first",
                    "fontFace": [
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-300-normal.woff2"
                            ],
                            "fontWeight": "300",
                            "fontStyle": "normal",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-400-normal.woff2"
                            ],
                            "fontWeight": "400",
                            "fontStyle": "normal",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-500-normal.woff2"
                            ],
                            "fontWeight": "500",
                            "fontStyle": "normal",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-600-normal.woff2"
                            ],
                            "fontWeight": "600",
                            "fontStyle": "normal",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-700-normal.woff2"
                            ],
                            "fontWeight": "700",
                            "fontStyle": "normal",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-800-normal.woff2"
                            ],
                            "fontWeight": "800",
                            "fontStyle": "normal",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-300-italic.woff2"
                            ],
                            "fontWeight": "300",
                            "fontStyle": "italic",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-400-italic.woff2"
                            ],
                            "fontWeight": "400",
                            "fontStyle": "italic",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-500-italic.woff2"
                            ],
                            "fontWeight": "500",
                            "fontStyle": "italic",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-600-italic.woff2"
                            ],
                            "fontWeight": "600",
                            "fontStyle": "italic",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-700-italic.woff2"
                            ],
                            "fontWeight": "700",
                            "fontStyle": "italic",
                            "fontFamily": "\"Open Sans\""
                        },
                        {
                            "src": [
                                "file:./assets/fonts/open-sans/open-sans-800-italic.woff2"
                            ],
                            "fontWeight": "800",
                            "fontStyle": "italic",
                            "fontFamily": "\"Open Sans\""
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "slug": "xxs",
                    "name": "xxs|12",
                    "size": "0.75rem"
                },
                {
                    "slug": "xs",
                    "name": "s|13",
                    "size": "0.813rem"
                },
                {
                    "slug": "s",
                    "name": "s|14",
                    "size": "0.875rem"
                },
                {
                    "slug": "m",
                    "name": "m|16",
                    "size": "1rem"
                },
                {
                    "slug": "ml",
                    "name": "ml|18",
                    "size": "1.125rem"
                },
                {
                    "slug": "l",
                    "name": "l|20",
                    "size": "1.25rem"
                },
                {
                    "slug": "xl",
                    "name": "xl|62",
                    "size": "clamp(1rem, 3.23vw, 62px)"
                },
                {
                    "slug": "xxl",
                    "name": "xxl|250",
                    "size": "clamp(2rem, 13.02vw, 250px)"
                },
                {
                    "slug": "h-one",
                    "name": "xxl|h1|72/40",
                    "size": "4.5rem",
                    "fluid": {
                        "max": "4.5rem",
                        "min": "2.5rem"
                    }
                },
                {
                    "slug": "h-two",
                    "name": "xl|h2|56/36",
                    "size": "3.5rem",
                    "fluid": {
                        "max": "3.5rem",
                        "min": "2.25rem"
                    }
                },
                {
                    "slug": "h-three",
                    "name": "l|h3|34/28",
                    "size": "2.125rem",
                    "fluid": {
                        "max": "2.125rem",
                        "min": "1.75rem"
                    }
                },
                {
                    "slug": "h-four",
                    "name": "m|h4|28/24",
                    "size": "1.75rem",
                    "fluid": {
                        "max": "1.75rem",
                        "min": "1.5rem"
                    }
                },
                {
                    "slug": "h-five",
                    "name": "s|h5|21",
                    "size": "1.3125rem"
                }
            ]
        },
        "spacing": {

            "spacingSizes": [
                {
                    "slug": "4",
                    "name": "0.25rem (4px)",
                    "size": ".25rem"
                },
                {
                    "slug": "8",
                    "name": "0.5rem (8px)",
                    "size": ".5rem"
                },
                {
                    "slug": "12",
                    "name": "0.75rem (12px)",
                    "size": ".75rem"
                },
                {
                    "slug": "16",
                    "name": "1rem (16px)",
                    "size": "1rem"
                },

                {
                    "slug": "24",
                    "name": "1.5rem (24px)",
                    "size": "1.5rem"
                },
                {
                    "slug": "32",
                    "name": "2rem (32px)",
                    "size": "2rem"
                },
                {
                    "slug": "32-40",
                    "name": "2rem (32px) → 2.5rem (40px)",
                    "size": "clamp(2rem, 1.7222rem + 0.8889vw, 2.5rem)"
                },
               {
                    "slug": "32-80",
                    "name": "2rem (32px) → 5rem (80px)",
                    "size": "clamp(2rem, 0.3333rem + 5.3333vw, 5rem)"
                },
                {
                    "slug": "32-48",
                    "name": "2rem (32px) → 3rem (48px)",
                    "size": "clamp(2rem, 1.4444rem + 1.7778vw, 3rem)"
                },
                {
                    "slug": "32-72",
                    "name": "2rem (32px) → 4.5rem (72px)",
                    "size": "clamp(2rem, 0.6111rem + 4.4444vw, 4.5rem)"
                },
                {
                    "slug": "56-120",
                    "name": "3.5rem (56px) → 7.5rem (120px)",
                    "size": "clamp(3.5rem, 1.2778rem + 7.1111vw, 7.5rem)"
                },
                {
                    "slug": "56-160",
                    "name": "3.5rem (56px) → 10rem (160px)",
                    "size": "clamp(3.5rem, -0.1111rem + 11.5556vw, 10rem)"
                },
                {
                    "slug": "56-200",
                    "name": "3.5rem (56px) → 12.5rem (200px)",
                    "size": "clamp(3.5rem, -1.5rem + 16vw, 12.5rem)"
                },
                {
                    "slug": "headerheight",
                    "name": "Header Height",
                    "size": "var(--header-height)"
                },
                {
                    "slug": "h-4",
                    "name": "H | 0.25rem (4px)",
                    "size": ".25rem"
                },
                {
                    "slug": "h-8",
                    "name": "H | 0.5rem (8px)",
                    "size": ".5rem"
                },
                {
                    "slug": "h-12",
                    "name": "H | 0.75rem (12px)",
                    "size": ".75rem"
                },
                {
                    "slug": "h-16",
                    "name": "H | 1rem (16px)",
                    "size": "1rem"
                },
                {
                    "slug": "h-24",
                    "name": "H | 1.5rem (24px)",
                    "size": "1.5rem"
                },
                {
                    "slug": "h-32",
                    "name": "H | 2rem (32px)",
                    "size": "2rem"
                },
                {
                    "slug": "h-16-40",
                    "name": "H | 1rem (16px) → 2.5rem (40px)",
                    "size": "clamp(1rem, 0.1667rem + 2.6667vw, 2.5rem)"
                },
                {
                    "slug": "h-16-48",
                    "name": "H | 1rem (16px) → 3rem (48px)",
                    "size": "clamp(1rem, -0.1111rem + 3.5556vw, 3rem)"
                },
                {
                    "slug": "h-16-72",
                    "name": "H | 1rem (16px) → 4.5rem (72px)",
                    "size": "clamp(1rem, -0.9444rem + 6.2222vw, 4.5rem)"
                },
                {
                    "slug": "h-16-120",
                    "name": "H | 1rem (16px) → 7.5rem (120px)",
                    "size": "clamp(1rem, -2.6111rem + 11.5556vw, 7.5rem)"
                },
                {
                    "slug": "h-16-160",
                    "name": "H | 1rem (16px) → 10rem (160px)",
                    "size": "clamp(1rem, -4rem + 16vw, 10rem)"
                },
                {
                    "slug": "h-16-200",
                    "name": "H | 1rem (16px) → 12.5rem (200px)",
                    "size": "clamp(1rem, -5.3889rem + 20.4444vw, 12.5rem)"
                }

            ],
            "defaultSpacingSizes": false,
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        }
    },
    "styles": {
        "css": "where(.wp-site-blocks) > * { margin-block-start: 0 !important; margin-block-end: 0 !important; }",
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--first)",
            "lineHeight" : "1.25"
        },
        "color": {
            "background": "var(--wp--preset--color--base)"
        },
        "elements": {
            "heading": {
                "color":{
                    "text" : "var(--wp--preset--color--base-2)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--second)"
                }
            },
            "h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-one)",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-three)",
                    "lineHeight": "1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-four)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-four)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-five)"
				}
			}
        },
        "blocks": {
            "core/paragraph":{
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--m)",
                    "lineHeight" : "1.25"
                }
            },
            "core/quote": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-four)",
                    "fontWeight" :"600",
                    "lineHeight": "1.15",
                    "textAlign": "center",
                    "fontStyle" : "italic"
                },
                 "css": "text-wrap:pretty;"
            },
            "core/list-item": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--m)",
                    "lineHeight" : "1.25"
                },
                "spacing": {
                "margin": {
                    "bottom": "var:preset|spacing|1"
                    }
                }
            },
            "core/image":{
                "border": {
                    "radius": "var(--wp--preset--border-radius--s)"
                }
            },
            "core/media-text":{
                "css":"& img{border-radius:var(--wp--preset--border-radius--s)}"
    
            },
            "core/button": {
                "css": "transition: all 0.3s ease; &:hover{background:var(--btn-hover-bg,var(--wp--preset--color--base-2));}",
            "color": {
                "background": "var(--wp--preset--color--contrast)"
            },
            "border": {
                "color": "var(--wp--preset--color--base)",
                "radius": {
                "topLeft": "var(--wp--preset--border-radius--l)",
                "topRight": "var(--wp--preset--border-radius--l)",
                "bottomLeft": "var(--wp--preset--border-radius--l)",
                "bottomRight": "var(--wp--preset--border-radius--l)"
                }
            },
            "spacing": {
                "padding": {
                "top": "var(--wp--preset--spacing--8)",
                "bottom": "var(--wp--preset--spacing--8)",
                "left": "var(--wp--preset--spacing--16)",
                "right": "var(--wp--preset--spacing--16)"
                }
            },
            "typography": {
                "lineHeight": "1.25",
                "fontWeight" :"700"
            }
            }
        }
    }
}