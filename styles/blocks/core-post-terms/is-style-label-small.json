{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "slug": "label-small",
    "title": "Label - Small",
    "blockTypes": [
        "core/post-terms"
    ],
    "styles": {
        "elements": {
            "link": {
                "css" :"display:inline-block;",
                "typography": {
                    "textDecoration": "none",
                    "fontWeight": "700",
                    "fontSize": "var(--wp--preset--font-size--xs)",
                    "lineHeight": "1.5"
                },
                "border": {
                    "radius": "var(--wp--preset--border-radius--rounded)"
                },
                "color": {
                    "background": "var(--wp--preset--color--base-4)",
                    "text": "var(--wp--preset--color--base-2)"
                },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--8)",
                        "bottom": "var(--wp--preset--spacing--8)",
                        "left": "var(--wp--preset--spacing--16)",
                        "right": "var(--wp--preset--spacing--16)"
                    }
                }
            }
        }
    }
}